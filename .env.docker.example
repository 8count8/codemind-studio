# Copy this file to .env.docker and replace every CHANGE_ME value.
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
SESSION_COOKIE_SECURE=false

MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
DB_USER=codemind
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
