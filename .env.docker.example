ADMIN_USERNAMES=admin
OLLAMA_MODEL=qwen2.5:7b
SANDBOX_TIMEOUT=5
AI_TIMEOUT_SECONDS=9

EMAIL_TYPE=NETEASE_EMAIL_SMTP_SSL
