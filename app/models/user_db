USE cms_test;
-- 用户表
CREATE TABLE IF NOT EXISTS users (
    id INT AUTO_INCREMENT PRIMARY KEY,          -- 用户ID，主键，自增
    username VARCHAR(255) UNIQUE NOT NULL,      -- 用户名，唯一且不能为空
    password TEXT NOT NULL,                     -- 密码（加密后存储），不能为空
    email VARCHAR(255) UNIQUE NOT NULL          -- 邮箱，唯一且不能为空
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- 验证码
CREATE TABLE IF NOT EXISTS verification_codes (
    id INT AUTO_INCREMENT PRIMARY KEY,         -- 自增主键
    email VARCHAR(255) UNIQUE NOT NULL,        -- 邮箱地址，唯一且不能为空
    code VARCHAR(6) NOT NULL,                  -- 验证码，长度为6位数字
    sent_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP, -- 验证码发送时间，默认为当前时间
    expires_at TIMESTAMP NOT NULL              -- 验证码过期时间
);

-- 题目存储表
CREATE TABLE problems (
    id INT AUTO_INCREMENT PRIMARY KEY,          -- 自增主键
    title VARCHAR(255) NOT NULL,                -- 题目标题
    content TEXT NOT NULL,                      -- 题目内容（Markdown 格式）
    difficulty VARCHAR(100) NOT NULL,           -- 难度等级（如 "简单", "中等", "困难"）
    tags JSON NOT NULL,                         -- 标签列表（JSON 格式）
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP -- 创建时间
) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

-- 测试用例表
CREATE TABLE test_cases (
    id INT AUTO_INCREMENT PRIMARY KEY,          -- 测试用例编号，主键
    problem_id INT NOT NULL,                    -- 关联题目表的题目编号，外键
    input_data TEXT NOT NULL,                   -- 测试用例的输入数据
    expected_output TEXT NOT NULL,              -- 测试用例的预期输出数据
    FOREIGN KEY (problem_id) REFERENCES problems(id) ON DELETE CASCADE -- 外键约束，级联删除
) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

-- 用户收藏表：存储用户收藏的题目
CREATE TABLE user_favorites (
    id INT PRIMARY KEY AUTO_INCREMENT,
    user_id INT NOT NULL,
    question_id INT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (question_id) REFERENCES problems(id)  -- 修改为引用problems表
);

ALTER TABLE user_favorites ADD COLUMN favorite BOOLEAN DEFAULT FALSE;