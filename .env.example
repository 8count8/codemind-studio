# ===== 应用配置 =====
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-this
# HTTP 本地/Docker 保持 false；HTTPS 反向代理部署改为 true
SESSION_COOKIE_SECURE=false

# ===== MySQL 数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=codemind
DB_PASSWORD=your-database-password
DB_NAME=codemind

# ===== Ollama 本地大模型（零 API Token、完全离线、零费用）=====
# 安装步骤：
#   1. 下载 Ollama:  https://ollama.com/download
#   2. 启动服务:     ollama serve          （开一个新终端）
#   3. 拉模型:       ollama pull qwen2.5:7b   （中文代码通用，~4.7GB）
#      其他推荐：
#        ollama pull deepseek-coder-v2:16b   （代码审查更强，~9.5GB）
#        ollama pull qwen2.5-coder:7b        （阿里代码专用，~4.7GB）
#        ollama pull qwen2.5:14b             （创意出题更强，~8.5GB）
# 网络要求：仅首次拉模型需要联网下载，之后完全离线可用

# Ollama HTTP 服务地址（本地默认即可）
OLLAMA_BASE_URL=http://localhost:11434/v1
# 全局使用的模型名（可被各 Model 的 ollama_model_name 字段覆盖）
OLLAMA_MODEL=qwen2.5:7b

# ===== 邮件服务配置（网易邮箱）=====
EMAIL_TYPE=NETEASE_EMAIL_SMTP_SSL
EMAIL_ADDRESS=cms202504@163.com
EMAIL_PASSWORD=your-email-auth-code

# ===== CORS 配置 =====
# 允许的前端地址（多个用逗号分隔）
CORS_ORIGINS=http://106.55.16.213

# ===== 服务器配置 =====
SERVER_IP=106.55.16.213
DOMAIN=106.55.16.213
