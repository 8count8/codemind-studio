# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 数据库连接（从 Supabase 控制台获取）
# 格式: postgresql://postgres:密码@host:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres

# Flask 配置
FLASK_ENV=production
SECRET_KEY=请在生产环境设置随机密钥

# CORS 配置（允许的前端地址，多个用逗号分隔）
CORS_ORIGINS=https://codemind-studio.netlify.app,http://localhost:5173

# 邮件服务配置（用于验证码功能）
# DrunkEmailTool 使用 163 网易邮箱 SMTP
EMAIL_TYPE=NETEASE_EMAIL_SMTP_SSL
EMAIL_ADDRESS=your_cms_email@163.com
EMAIL_PASSWORD=your_smtp_authorization_code
EMAIL_RECEIVERS=

# 兼容旧代码保留
SMTP_SERVER=smtp.163.com
SMTP_PORT=465
EMAIL_ACCOUNT=your_cms_email@163.com
# EMAIL_PASSWORD 已在上方定义